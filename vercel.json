{
  "version": 2,
  "builds": [
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)\\.(html|css|js|png|jpg|jpeg|gif|svg|ico|json|xml|txt)",
      "dest": "/public/$1.$2"
    },
    {
      "src": "/",
      "dest": "/public/index.html"
    },
    {
      "src": "/shop",
      "dest": "/public/shop.html"
    },
    {
      "src": "/about",
      "dest": "/public/about.html"
    },
    {
      "src": "/cart",
      "dest": "/public/cart.html"
    },
    {
      "src": "/checkout",
      "dest": "/public/checkout.html"
    },
    {
      "src": "/wishlist",
      "dest": "/public/wishlist.html"
    },
    {
      "src": "/track-order",
      "dest": "/public/track-order.html"
    },
    {
      "src": "/contact",
      "dest": "/public/contact.html"
    },
    {
      "src": "/privacy",
      "dest": "/public/privacy.html"
    },
    {
      "src": "/terms",
      "dest": "/public/terms.html"
    },
    {
      "src": "/product/(.*)",
      "dest": "/public/product.html"
    },
    {
      "src": "/admin-about",
      "dest": "/public/admin-about.html"
    }
  ]
}